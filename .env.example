# JobPilot AI — необязательная конфигурация на этапе сборки.
#
# Расширение полностью работает локально с API-ключом, который пользователь
# вводит в настройках (режим LOCAL). Для разработки здесь ничего не требуется, и
# СЮДА НЕЛЬЗЯ КЛАСТЬ СЕКРЕТЫ: всё с префиксом VITE_ попадает в публичный бандл.

# Адрес AI-шлюза для облачного режима (ваш бэкенд, который хранит ключи).
# Оставьте пустым, чтобы работал только локальный режим.
VITE_JOBPILOT_CLOUD_ENDPOINT=

# Показывается в настройках, чтобы пользователь видел, кто держит шлюз.
VITE_JOBPILOT_CLOUD_LABEL=

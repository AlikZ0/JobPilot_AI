# JobPilot AI — optional build-time configuration.
#
# The extension works fully offline with a user-supplied API key entered in
# Settings (LOCAL mode). Nothing here is required for local development, and
# NO SECRET MUST EVER BE PUT IN THIS FILE — everything prefixed with VITE_ is
# inlined into the shipped bundle and is therefore public.

# Default AI gateway used by CLOUD mode (your own backend that holds the keys).
# Leave empty to force LOCAL mode.
VITE_JOBPILOT_CLOUD_ENDPOINT=

# Shown in Settings so users know who operates the cloud gateway.
VITE_JOBPILOT_CLOUD_LABEL=
